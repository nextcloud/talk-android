{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "schedule": ["* 1-4 * * *"],
  "minimumReleaseAge": "10 days",
  "labels": [
    "dependencies",
    "3. to review"
  ],
  "packageRules": [
    {
      // 5.23.0 has a regression in the Maker implementation that breaks the Android tests.
      // Remove this rule once a later release fixes it, so mockito can move again.
      "matchPackageNames": ["org.mockito:mockito-core", "org.mockito:mockito-android"],
      "allowedVersions": "!/^5[.]23[.]0$/"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchPackageNames": ["/^com\\.github\\.nextcloud/", "nextcloud/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": ["com.github.nextcloud-deps.hwsecurity:hwsecurity-fido2", "com.github.nextcloud-deps.hwsecurity:hwsecurity-fido", "fidoVersion", "com.fasterxml.jackson.core:jackson-core"],
      "automerge": false,
	  "enabled": false
    }
  ],
}
