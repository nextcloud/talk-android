<!-- From Android 12 on, instead of backup_config: the copies of the files other apps shared, which are only kept until
     they are uploaded -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="shared_file_copies/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="shared_file_copies/" />
    </device-transfer>
</data-extraction-rules>
